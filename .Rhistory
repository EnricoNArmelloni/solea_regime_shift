pm1=ggplot()+
geom_sf(data=t2, aes(fill=log(Regime1+1)), color=NA)+
geom_sf(data=closure3, fill=NA, color='red')+
scale+
ggtitle('R1')+
labs(fill='log juveniles density (n/km2)')+
theme(panel.background = element_rect(fill='white'))+
theme(legend.position = 'bottom')+
geom_sf(data=st_crop(xcountry, st_buffer(basegrid, 1000*50)), fill='gray50')+
geom_sf(data=st_crop(xcountry2, st_buffer(basegrid, 1000*50)), fill='gray50')+
annotation_scale()  ;pm1
pm2=ggplot(data=t2)+
geom_sf(aes(fill=log(Regime2+1)), color=NA)+
geom_sf(data=closure6, fill=NA, color='red')+
scale+
ggtitle('R2')+
labs(fill='log juveniles density (n/km2)')+
theme(panel.background = element_rect(fill='white'))+
theme(legend.position = 'bottom')+
geom_sf(data=st_crop(xcountry, st_buffer(basegrid, 1000*50)), fill='gray50')+
geom_sf(data=st_crop(xcountry2, st_buffer(basegrid, 1000*50)), fill='gray50')+
annotation_scale();pm2
pm3=ggplot(data=t2)+
geom_sf(aes(fill=log(diff+1)), color=NA)+
geom_sf(data=closure6, fill=NA, color='red')+
scale+
ggtitle('R2-R1')+
labs(fill='log juveniles density (n/km2)')+
theme(panel.background = element_rect(fill='white'))+
theme(legend.position = 'bottom')+
geom_sf(data=st_crop(xcountry, st_buffer(basegrid, 1000*50)), fill='gray50')+
geom_sf(data=st_crop(xcountry2, st_buffer(basegrid, 1000*50)), fill='gray50')+
annotation_scale();pm3
pr4=ggpubr::ggarrange(pm1,pm2, pm3, nrow=1, common.legend = T)
ggsave(plot=pr4, 'results/analysis_3d/plots/fig4.jpeg', width = 25, height = 12, units='cm')
