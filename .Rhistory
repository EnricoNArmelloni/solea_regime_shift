p <- p+geom_smooth(data = solea_tot, aes(x =year, y =Abun_tot ),color = "#225ea8")
p <-p+geom_vline(aes(xintercept =2012), col="black", linetype = "dashed")#vertical line
p <- p+ ylab(expression("Population - density/km"^2))+xlab("Year")
p <- p+ theme_bw()
p
